{
  "name": "@taisan11/vite-plugin-webext",
  "version": "0.2.0",
  "description": "Vite plugin for cross-browser web extension builds",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "private": false,
  "files": [
    "SKILL.md",
    "dist",
    "src/webext-types.d.ts",
    "!dist/index.mjs.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "import": "./dist/i18n/index.mjs",
      "default": "./dist/i18n/index.mjs"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.mts",
      "import": "./dist/messaging/index.mjs",
      "default": "./dist/messaging/index.mjs"
    },
    "./types": "./src/webext-types.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --dts",
    "build:watch": "tsdown --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.1.42",
    "tsdown": "^0.22.1",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@zip.js/zip.js": "^2.8.26",
    "magic-string": "^0.30.21"
  }
}

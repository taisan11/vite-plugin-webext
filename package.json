{
  "name": "@taisan11/vite-plugin-webext",
  "version": "0.5.1",
  "description": "Vite plugin for cross-browser web extension builds",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "private": false,
  "bin": {
    "vite-plugin-webext": "./dist/cli.mjs"
  },
  "files": [
    "SKILL.md",
    "dist",
    "src/webext-types.d.ts",
    "!dist/index.mjs.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "import": "./dist/i18n/index.mjs",
      "default": "./dist/i18n/index.mjs"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.mts",
      "import": "./dist/messaging/index.mjs",
      "default": "./dist/messaging/index.mjs"
    },
    "./types": "./src/webext-types.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --dts",
    "build:watch": "tsdown --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.2",
    "tsdown": "^0.22.12",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@zip.js/zip.js": "^2.8.31",
    "magic-string": "^1.0.0"
  }
}

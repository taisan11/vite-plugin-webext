{
  "name": "@taisan11/vite-plugin-webext",
  "version": "0.6.2",
  "description": "Vite plugin for cross-browser web extension builds",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "private": false,
  "bin": {
    "vite-plugin-webext": "./dist/cli.mjs"
  },
  "files": [
    "SKILL.md",
    "dist",
    "src/webext-types.d.ts",
    "!dist/index.mjs.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.mts",
      "import": "./dist/i18n/index.mjs",
      "default": "./dist/i18n/index.mjs"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.mts",
      "import": "./dist/messaging/index.mjs",
      "default": "./dist/messaging/index.mjs"
    },
    "./inject-script": {
      "types": "./dist/inject-script.d.mts",
      "import": "./dist/inject-script.mjs",
      "default": "./dist/inject-script.mjs"
    },
    "./types": "./src/webext-types.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --dts",
    "build:watch": "tsdown --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "vite": "^8.3.3",
    "vitepress": "^2.0.0-alpha.18",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@zip.js/zip.js": "^2.23.0",
    "magic-string": "^1.4.3"
  }
}
